APP_NAME=assistant-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO
INTERNAL_SERVICE_TOKEN=change-me
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_BACK_TO_LLM_QUEUE=back_to_llm
RABBITMQ_LLM_TO_BACK_QUEUE=llm_to_back
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_REQUEUE_DELAY_SECONDS=1.0
