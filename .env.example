APP_NAME=assistant-service
APP_ENV=development
LOG_LEVEL=INFO
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_BACK_TO_LLM_QUEUE=back_to_llm
RABBITMQ_LLM_TO_BACK_QUEUE=llm_to_back
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_REQUEUE_DELAY_SECONDS=1.0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRY_MAX_ATTEMPTS=3
GEMINI_RETRY_INITIAL_DELAY_SECONDS=0.5
GEMINI_RETRY_MAX_DELAY_SECONDS=4.0
GEMINI_MAX_USER_PROMPT_CHARS=4000
GEMINI_MAX_CHUNK_CHARS=12000
GEMINI_MAX_CHUNKS_PER_REQUEST=32
GEMINI_MAX_PROMPT_CHARS=16000
GEMINI_MAX_RESPONSE_CHARS=12000
RABBITMQ_MAX_PROCESSING_ATTEMPTS=3
REDIS_URL=redis://localhost:6379/0
REDIS_ANSWER_CACHE_TTL_SECONDS=900
REDIS_INTENT_CACHE_TTL_SECONDS=900
REDIS_TASK_STATUS_TTL_SECONDS=3600
REDIS_SESSION_SUMMARY_TTL_SECONDS=21600
REDIS_ANSWER_LOCK_TTL_SECONDS=90
RETRIEVAL_CACHE_TTL_SECONDS=900
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=documents
ELASTICSEARCH_TIMEOUT_SECONDS=5
ELASTICSEARCH_MAX_RESULTS=8
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_SPIKE_ENABLED=false
